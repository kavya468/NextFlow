# Web application and database. Use a separate development database.
DATABASE_URL=postgresql://nextflow:nextflow@127.0.0.1:5432/nextflow
DIRECT_URL=postgresql://nextflow:nextflow@127.0.0.1:5432/nextflow
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Trigger.dev development environment (also set your project in trigger.config.ts).
TRIGGER_SECRET_KEY=

# API key management and upload rate limiting.
UNKEY_ROOT_KEY=
UNKEY_API_ID=

# Uploads and processed media storage.
NEXT_PUBLIC_TRANSLOADIT_AUTH_KEY=
TRANSLOADIT_AUTH_SECRET=

# Worker provider credentials. Configure only providers you intend to use.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FAL_KEY=
# Generate a random signing secret; use the same value on the app and worker.
FAL_WEBHOOK_SECRET=

# Optional local media binary paths when ffmpeg/ffprobe are not on PATH.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
